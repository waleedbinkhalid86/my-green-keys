NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
NEXT_PUBLIC_PADDLE_FAMILY_PRICE_ID=
NEXT_PUBLIC_PADDLE_SCHOOL_STARTER_PRICE_ID=
NEXT_PUBLIC_PADDLE_SCHOOL_GROWTH_PRICE_ID=
