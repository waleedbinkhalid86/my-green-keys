# Signs class kiosk device tokens (server only, never NEXT_PUBLIC). Kiosk routes
# refuse all requests if this is missing. Changing it logs out every kiosk device.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KIOSK_TOKEN_SECRET=

# Resend API key for /schools inquiry email alerts (server only). If unset, inquiries
# are still saved and shown on /admin/inquiries, just without an email.
RESEND_API_KEY=
# Where inquiry alerts go. Defaults to mygreenkeys26@gmail.com. Without a verified
# domain in Resend, this must be the Resend account owner's email.
INQUIRY_ALERT_EMAIL=
